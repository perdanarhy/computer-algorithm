{
  "name": "computer-algorithms-slides",
  "private": true,
  "version": "0.1.0",
  "description": "Marp slide deck for Computer Algorithms (506994-002)",
  "scripts": {
    "preview": "marp -s slides --theme-set themes/algorithms.css --html",
    "build:html": "marp -I slides --theme-set themes/algorithms.css --html --allow-local-files -o dist",
    "build:pdf": "marp -I slides --theme-set themes/algorithms.css --html --pdf --allow-local-files -o dist",
    "build:pptx": "marp -I slides --theme-set themes/algorithms.css --html --pptx --allow-local-files -o dist",
    "build:materials": "node scripts/build-materials.js dist"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.1"
  }
}
